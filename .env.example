# ==============================================================================
# PaperPilot Environment Configuration Template
# Copy this file to .env and replace placeholder values with your own secrets.
# ==============================================================================

# --- Application Settings ---
APP_NAME=PaperPilot
APP_VERSION=0.1.0
DEBUG=false

# --- Authentication & Security ---
# REQUIRED: Secret key used to sign and verify JSON Web Tokens (JWT).
# Generate a secure 64-character hex key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key

# --- Database Configuration ---
# Local development default: SQLite async driver
DATABASE_URL=sqlite+aiosqlite:///paperpilot.db

# Production PostgreSQL example (uses asyncpg driver):
# DATABASE_URL=postgresql+asyncpg://paperpilot_user:strong_password@localhost:5432/paperpilot_db

# --- Google Gemini AI / LLM Configuration ---
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- File Storage & Upload Limits ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# --- OCR Engine Configuration ---
# Comma-separated ISO 639-1 language codes supported by EasyOCR (e.g. en,fr,es,de)
OCR_LANGUAGES=en
# Enable CUDA acceleration for EasyOCR if an NVIDIA GPU is available
OCR_GPU=false

# --- API Security & Rate Limiting ---
# Comma-separated allowed origins for CORS headers
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60

# --- Frontend Configuration (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- Docker Compose / Production Deployments ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paperpilot
POSTGRES_PORT=5432
